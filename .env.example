CPL_API_KEY=pk_...
N3D_API_KEY=n3d_sk_...
RESEND_API_KEY=re_...
REQUEST_TO=you@example.com
# Optional: a sender on a domain verified in Resend (default only delivers to your own Resend account email)
REQUEST_FROM=Print Requests <onboarding@resend.dev>
# Optional: how long the catalogue is cached in seconds (default 86400 = 24h)
CACHE_SECONDS=86400
